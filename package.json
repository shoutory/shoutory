{
  "name": "shoutory",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "test": "vitest run --passWithNoTests && node --test \"packages/testkit/test/*/*.test.mjs\"",
    "test:unit": "vitest run --passWithNoTests --project unit --project unit-chatham --project web --project web-chatham",
    "test:integration": "vitest run --passWithNoTests --project integration",
    "test:contract": "vitest run --passWithNoTests --project contract && node --test \"packages/testkit/test/contract/*.test.mjs\"",
    "test:focus": "vitest run --passWithNoTests",
    "image-smoke": "node scripts/image-smoke.mjs",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "build": "tsc -b && pnpm --filter @shoutory/web run build",
    "knip": "knip",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@better-auth/utils": "0.5.1",
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "26.6.6",
    "knip": "6.44.1",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
