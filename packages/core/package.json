{
  "name": "@shoutory/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "exports": {
    "./authz": {
      "source": "./src/authz/matrix.ts",
      "default": "./dist/authz/matrix.js"
    },
    "./config": {
      "source": "./src/config/env.ts",
      "default": "./dist/config/env.js"
    },
    "./crypto": {
      "source": "./src/crypto/envelope.ts",
      "default": "./dist/crypto/envelope.js"
    },
    "./errors": {
      "source": "./src/errors/codes.ts",
      "default": "./dist/errors/codes.js"
    },
    "./password": {
      "source": "./src/password/policy.ts",
      "default": "./dist/password/policy.js"
    },
    "./keys": {
      "source": "./src/crypto/keys.ts",
      "default": "./dist/crypto/keys.js"
    }
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
