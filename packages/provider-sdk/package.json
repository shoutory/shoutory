{
  "name": "@shoutory/provider-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "exports": {
    "./egress": {
      "source": "./src/egress/client.ts",
      "default": "./dist/egress/client.js"
    },
    "./egress/errors": {
      "source": "./src/egress/errors.ts",
      "default": "./dist/egress/errors.js"
    },
    "./egress/policy": {
      "source": "./src/egress/policy.ts",
      "default": "./dist/egress/policy.js"
    },
    "./adapter": {
      "source": "./src/adapter.ts",
      "default": "./dist/adapter.js"
    },
    "./manifest": {
      "source": "./src/manifest/manifest.ts",
      "default": "./dist/manifest/manifest.js"
    },
    "./snapshot": {
      "source": "./src/snapshot.ts",
      "default": "./dist/snapshot.js"
    },
    "./result": {
      "source": "./src/result.ts",
      "default": "./dist/result.js"
    },
    "./registry": {
      "source": "./src/registry.ts",
      "default": "./dist/registry.js"
    },
    "./sunset": {
      "source": "./src/sunset.ts",
      "default": "./dist/sunset.js"
    },
    "./loopback": {
      "source": "./src/loopback.ts",
      "default": "./dist/loopback.js"
    },
    "./conformance": {
      "source": "./src/conformance/kit.ts",
      "default": "./dist/conformance/kit.js"
    },
    "./conformance/fault-matrix": {
      "source": "./src/conformance/fault-matrix.ts",
      "default": "./dist/conformance/fault-matrix.js"
    }
  },
  "dependencies": {
    "@shoutory/core": "workspace:*",
    "undici": "8.12.3",
    "zod": "4.6.7"
