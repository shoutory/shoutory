language js

// The restricted-properties rule reports reads only, so the writes need this plugin.
or {
  `$el.innerHTML = $value`,
  `$el.outerHTML = $value`,
  `$el["innerHTML"] = $value`,
  `$el["outerHTML"] = $value`,
  `$el['innerHTML'] = $value`,
  `$el['outerHTML'] = $value`,
  `$el.innerHTML += $value`,
  `$el.outerHTML += $value`,
  `document.write($args)`,
  `document.writeln($args)`
} as $write where {
  register_diagnostic(span=$write, message="Raw HTML write is banned; render text through React.")
}
