{
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**", "e2e/**"],
      "ignoreDependencies": ["@commitlint/cli", "turbo"]
    },
    "packages/testkit": {
