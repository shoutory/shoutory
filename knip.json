{
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "e2e/support/screens.ts", "e2e/fixtures/simulators-server.ts"],
      "project": ["scripts/**", "e2e/**"],
      "ignoreDependencies": ["@commitlint/cli", "turbo"],
      "ignoreBinaries": ["openssl"]
    },
    "packages/testkit": {
      "entry": ["test/*/*.test.mjs", "scripts/*.mjs"],
      "project": ["src/**", "test/**"]
    },
    "apps/web": {
      "entry": ["src/theme/bootstrap.js", "scripts/*.mjs"],
      "project": ["src/**", "scripts/**"],
      "ignoreDependencies": ["happy-dom", "@lingui/cli", "cldr-dates-full"]
    },
    "apps/api": {
      "entry": ["src/main.ts", "src/jobs/media/sharp-child.ts"],
      "project": ["src/**", "test/**"]
    }
  }
}
