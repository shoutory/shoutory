{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "customConditions": [],
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "test/**/*.ts", "vite.config.ts"],
  "references": [{ "path": "./tsconfig.json" }]
}
